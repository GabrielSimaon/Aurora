e,"color":"#512A35","fill":"#FFFDF9","align":"center"},{"type":"box","text":"Materia-Prima","x":290,"y":215,"w":190,"h":62,"size":22,"geom":"rect","bold":false,"color":"#512A35","fill":"#FFFDF9","align":"center"},{"type":"box","text":"Adicional","x":515,"y":215,"w":190,"h":62,"size":22,"geom":"rect","bold":false,"color":"#512A35","fill":"#FFFDF9","align":"center"},{"type":"box","text":"Categoria","x":745,"y":215,"w":190,"h":62,"size":22,"geom":"rect","bold":false,"color":"#512A35","fill":"#FFFDF9","align":"center"},{"type":"box","text":"Sabor","x":975,"y":215,"w":190,"h":62,"size":22,"geom":"rect","bold":false,"color":"#512A35","fill":"#FFFDF9","align":"center"},{"type":"box","text":"Produto","x":515,"y":345,"w":190,"h":62,"size":22,"geom":"rect","bold":false,"color":"#512A35","fill":"#FFFDF9","align":"center"},{"type":"box","text":"Tamanho","x":745,"y":345,"w":190,"h":62,"size":22,"geom":"rect","bold":false,"color":"#512A35","fill":"#FFFDF9","align":"center"},{"type":"box","text":"Pedido","x":290,"y":345,"w":190,"h":62,"size":22,"geom":"rect","bold":false,"color":"#512A35","fill":"#FFFDF9","align":"center"},{"type":"box","text":"Receita","x":290,"y":480,"w":190,"h":62,"size":22,"geom":"rect","bold":false,"color":"#512A35","fill":"#FFFDF9","align":"center"},{"type":"box","text":"Caixa","x":515,"y":480,"w":190,"h":62,"size":22,"geom":"rect","bold":false,"color":"#512A35","fill":"#FFFDF9","align":"center"},{"type":"box","text":"Despesa","x":745,"y":480,"w":190,"h":62,"size":22,"geom":"rect","bold":false,"color":"#512A35","fill":"#FFFDF9","align":"center"},{"type":"box","text":"Usuario","x":70,"y":345,"w":190,"h":62,"size":22,"geom":"rect","bold":false,"color":"#512A35","fill":"#FFFDF9","align":"center"},{"type":"box","text":"Grupo de Permissao","x":70,"y":480,"w":190,"h":62,"size":18,"geom":"rect","bold":false,"color":"#512A35","fill":"#FFFDF9","align":"center"},{"type":"box","text":"Permissao","x":70,"y":590,"w":190,"h":62,"size":22,"geom":"rect","bold":false,"color":"#512A35","fill":"#FFFDF9","align":"center"},{"type":"text","text":"Mapa de associações. Atributos, operações e multiplicidades detalhados no CD01.","x":300,"y":593,"w":875,"h":62,"size":23,"bold":false,"color":"#714C58","align":"left"}]},{"title":"Classes do pedido","notes":"No arquivo, Pedido também possui gerarRankingVendas(), que pertence ao modelo geral. O preço e o total descritos nos cenários são calculados no fluxo, sem serem apresentados como novos atributos nesta síntese. Não criamos uma classe ItemPedido, pois a classe do projeto é Produto.","elements":[{"type":"text","text":"Classes do pedido","x":64,"y":40,"w":1150,"h":65,"size":42,"bold":true,"color":"#512A35","align":"left"},{"type":"text","text":"Cada classe representa uma parte dos dados usados no atendimento.","x":66,"y":115,"w":1140,"h":65,"size":27,"bold":false,"color":"#714C58","align":"left"},{"type":"text","text":"18","x":1185,"y":674,"w":40,"h":24,"size":16,"bold":false,"color":"#8E737B","align":"right"},{"type":"text","text":"Pedido","x":68,"y":205,"w":1095,"h":40,"size":28,"bold":true,"color":"#512A35","align":"left"},{"type":"text","text":"id, dataHora. Operações: inserirPedido(), pesquisarPedido(), alterarPedido(), excluirPedido() e gerarCupom().","x":68,"y":248,"w":1120,"h":100,"size":26,"bold":false,"color":"#512A35","align":"left"},{"type":"text","text":"Produto","x":68,"y":345,"w":1095,"h":40,"size":28,"bold":true,"color":"#512A35","align":"left"},{"type":"text","text":"Representa o item em montagem e contém quantidade. Liga a escolha de categoria, tamanho, sabor e adicionais ao pedido.","x":68,"y":388,"w":1120,"h":100,"size":26,"bold":false,"color":"#512A35","align":"left"},{"type":"text","text":"Categoria, Tamanho, Sabor e Adicional","x":68,"y":485,"w":1095,"h":40,"size":28,"bold":true,"color":"#512A35","align":"left"},{"type":"text","text":"Categoria define preço e permissões. Tamanho e adicional têm preço de venda. Sabor identifica a opção escolhida.","x":68,"y":528,"w":1120,"h":100,"size":26,"bold":false,"color":"#512A35","align":"left"}]},{"title":"Classes de acesso e caixa","notes":"No CD01, Pedido e Receita possuem multiplicidade 1 nas duas pontas. Caixa se associa a Receita com 1 e 1..*. Usuario tem id, login e senha no modelo. A apresentação descreve o que está modelado, sem definir detalhes de implementação de autenticação.","elements":[{"type":"text","text":"Classes de acesso e caixa","x":64,"y":40,"w":1150,"h":65,"size":42,"bold":true,"color":"#512A35","align":"left"},{"type":"text","text":"Permissão e movimentação financeira sustentam as operações sobre pedidos.","x":66,"y":115,"w":1140,"h":65,"size":27,"bold":false,"color":"#714C58","align":"left"},{"type":"text","text":"19","x":1185,"y":674,"w":40,"h":24,"size":16,"bold":false,"color":"#8E737B","align":"right"},{"type":"text","text":"Usuario, Grupo de Permissao e Permissao","x":68,"y":205,"w":1095,"h":40,"size":28,"bold":true,"color":"#512A35","align":"left"},{"type":"text","text":"O modelo associa o usuário ao grupo e o grupo às permissões.","x":68,"y":248,"w":1120,"h":100,"size":26,"bold":false,"color":"#512A35","align":"left"},{"type":"text","text":"Pedido e Receita","x":68,"y":345,"w":1095,"h":40,"size":28,"bold":true,"color":"#512A35","align":"left"},{"type":"text","text":"A associação é de um para um. A receita guarda valorReceita e possui métodos para inserir, alterar e excluir.","x":68,"y":388,"w":1120,"h":100,"size":26,"bold":false,"color":"#512A35","align":"left"},{"type":"text","text":"Caixa e Despesa","x":68,"y":485,"w":1095,"h":40,"size":28,"bold":true,"color":"#512A35","align":"left"},{"type":"text","text":"Caixa possui fechado e data. Agrupa receitas e se relaciona às despesas do modelo geral.","x":68,"y":528,"w":1120,"h":100,"size":26,"bold":false,"color":"#512A35","align":"left"}]},{"title":"Cálculo do pedido","notes":"Os valores são apenas um exemplo para explicar a regra documentada. Não são preços reais fornecidos pela sorveteria. Sem adicionais, essa parcela do cálculo é zero. A quantidade deve ser um inteiro positivo.","elements":[{"type":"text","text":"Cálculo do pedido","x":64,"y":40,"w":1150,"h":65,"size":42,"bold":true,"color":"#512A35","align":"left"},{"type":"text","text":"O preço reúne as escolhas feitas para cada item.","x":66,"y":115,"w":1140,"h":65,"size":27,"bold":false,"color":"#714C58","align":"left"},{"type":"text","text":"20","x":1185,"y":674,"w":40,"h":24,"size":16,"bold":false,"color":"#8E737B","align":"right"},{"type":"text","text":"Preço unitário","x":68,"y":205,"w":1095,"h":40,"size":28,"bold":true,"color":"#512A35","align":"left"},{"type":"text","text":"Preço da categoria + preço do tamanho + soma dos adicionais.","x":68,"y":248,"w":1120,"h":100,"size":26,"bold":false,"color":"#512A35","align":"left"},{"type":"text","text":"Subtotal e total","x":68,"y":345,"w":1095,"h":40,"size":28,"bold":true,"color":"#512A35","align":"left"},{"type":"text","text":"Subtotal = preço unitário × quantidade. Total do pedido = soma dos subtotais.","x":68,"y":388,"w":1120,"h":100,"size":26,"bold":false,"color":"#512A35","align":"left"},{"type":"text","text":"Exemplo ilustrativo","x":68,"y":485,"w":1095,"h":40,"size":28,"bold":true,"color":"#512A35","align":"left"},{"type":"text","text":"Categoria R$ 6 + tamanho R$ 2 + adicional R$ 1 = R$ 9 por unidade.\nDuas unidades: R$ 18. Recebido R$ 20: troco de R$ 2.","x":68,"y":528,"w":1120,"h":100,"size":26,"bold":false,"color":"#512A35","align":"left"}]},{"title":"Como os diagramas se conectam","notes":"Use cadastrar pedido como exemplo: o cenário exige gravação da venda e da receita. O DS02 mostra inserirPedido() e inserirReceita(). O CD01 contém Pedido, Receita e a associação entre eles. Essa relação é um bom ponto de partida para responder às perguntas do professor.","elements":[{"type":"text","text":"Como os diagramas se conectam","x":64,"y":40,"w":1150,"h":65,"size":42,"bold":true,"color":"#512A35","align":"left"},{"type":"text","text":"Cada visão responde a uma parte da mesma operação.","x":66,"y":115,"w":1140,"h":65,"size":27,"bold":false,"color":"#714C58","align":"left"},{"type":"text","text":"21","x":1185,"y":674,"w":40,"h":24,"size":16,"bold":false,"color":"#8E737B","align":"right"},{"type":"text","text":"Caso de uso e cenário","x":68,"y":205,"w":1095,"h":40,"size":28,"bold":true,"color":"#512A35","align":"left"},{"type":"text","text":"Mostram o objetivo do usuário, as condições e o que muda em cada alternativa.","x":68,"y":248,"w":1120,"h":100,"size":26,"bold":false,"color":"#512A35","align":"left"},{"type":"text","text":"Diagrama de sequência","x":68,"y":345,"w":1095,"h":40,"size":28,"bold":true,"color":"#512A35","align":"left"},{"type":"text","text":"Mostra a ordem das mensagens entre usuário, tela, controle e entidades.","x":68,"y":388,"w":1120,"h":100,"size":26,"bold":false,"color":"#512A35","align":"left"},{"type":"text","text":"Diagrama de classes","x":68,"y":485,"w":1095,"h":40,"size":28,"bold":true,"color":"#512A35","align":"left"},{"type":"text","text":"Mostra os dados, as operações e as relações que dão suporte ao comportamento.","x":68,"y":528,"w":1120,"h":100,"size":26,"bold":false,"color":"#512A35","align":"left"}]},{"title":"Pontos para a discussão","notes":"Encerramento sugerido: nosso recorte descreve tanto o atendimento esperado quanto as alternativas que precisam ser tratadas. Na apresentação, todos devem conseguir explicar a ligação entre cenário, sequência e classes. Referência de conteúdo: Sorveteria_Kidelicia_Equipe_1_WhiteStarUML(1).uml.","elements":[{"type":"text","text":"Pontos para a discussão","x":64,"y":40,"w":1150,"h":65,"size":42,"bold":true,"color":"#512A35","align":"left"},{"type":"text","text":"As decisões ficam mais claras quando usamos situações do atendimento.","x":66,"y":115,"w":1140,"h":65,"size":27,"bold":false,"color":"#714C58","align":"left"},{"type":"text","text":"22","x":1185,"y":674,"w":40,"h":24,"size":16,"bold":false,"color":"#8E737B","align":"right"},{"type":"text","text":"Por que usar include e extend?","x":68,"y":205,"w":1095,"h":40,"size":28,"bold":true,"color":"#512A35","align":"left"},{"type":"text","text":"Categoria e tamanho integram a escolha. Sabor e adicionais dependem das condições previstas.","x":68,"y":248,"w":1120,"h":100,"size":26,"bold":false,"color":"#512A35","align":"left"},{"type":"text","text":"Por que alterar ou excluir afeta o caixa?","x":68,"y":345,"w":1095,"h":40,"size":28,"bold":true,"color":"#512A35","align":"left"},{"type":"text","text":"Porque a receita precisa acompanhar o valor e a existência do pedido.","x":68,"y":388,"w":1120,"h":100,"size":26,"bold":false,"color":"#512A35","align":"left"},{"type":"text","text":"Por que uma falha na impressora não cancela a venda?","x":68,"y":485,"w":1095,"h":40,"size":28,"bold":true,"color":"#512A35","align":"left"},{"type":"text","text":"Porque pedido e receita já foram registrados. O próximo passo é solicitar a impressão novamente.","x":68,"y":528,"w":1120,"h":100,"size":26,"bold":false,"color":"#512A35","align":"left"}]}]