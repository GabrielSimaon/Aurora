ita()","x":648,"y":427,"w":510,"h":29,"size":19,"bold":false,"color":"#512A35","align":"left"},{"type":"line","x1":640,"y1":505,"x2":902.5,"y2":505,"arrow":true,"dashed":false},{"type":"text","text":"5. gerarCupom()","x":648,"y":477,"w":320,"h":29,"size":19,"bold":false,"color":"#512A35","align":"left"},{"type":"line","x1":640,"y1":555,"x2":377.5,"y2":555,"arrow":true,"dashed":false},{"type":"text","text":"6. Informar conclusão","x":385.5,"y":527,"w":320,"h":29,"size":19,"bold":false,"color":"#512A35","align":"left"},{"type":"text","text":"Antes da gravação: permissão, caixa e pagamento. Depois: envio à Impressora.","x":65,"y":630,"w":1150,"h":42,"size":22,"bold":false,"color":"#714C58","align":"left"}]},{"title":"DS03 · Pesquisar pedido","notes":"O fluxo completo também trata código inválido, usuário sem permissão e nova pesquisa. A mensagem de resultado não é uma gravação: só apresenta o que foi localizado.","elements":[{"type":"text","text":"DS03 · Pesquisar pedido","x":64,"y":40,"w":1150,"h":65,"size":42,"bold":true,"color":"#512A35","align":"left"},{"type":"text","text":"O código informado orienta a consulta.","x":66,"y":115,"w":1140,"h":65,"size":27,"bold":false,"color":"#714C58","align":"left"},{"type":"text","text":"14","x":1185,"y":674,"w":40,"h":24,"size":16,"bold":false,"color":"#8E737B","align":"right"},{"type":"box","text":"Usuário","x":28,"y":198,"w":174,"h":62,"size":21,"geom":"rect","bold":false,"color":"#512A35","fill":"#FFFDF9","align":"center"},{"type":"line","x1":115,"y1":260,"x2":115,"y2":602,"arrow":false,"dashed":true},{"type":"box","text":"Tela de\npedidos","x":378,"y":198,"w":174,"h":62,"size":21,"geom":"rect","bold":false,"color":"#512A35","fill":"#FFFDF9","align":"center"},{"type":"line","x1":465,"y1":260,"x2":465,"y2":602,"arrow":false,"dashed":true},{"type":"box","text":"Controle de\npedidos","x":728,"y":198,"w":174,"h":62,"size":21,"geom":"rect","bold":false,"color":"#512A35","fill":"#FFFDF9","align":"center"},{"type":"line","x1":815,"y